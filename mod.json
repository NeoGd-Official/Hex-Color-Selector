{
    "geode": "5.10.1",
    "gd": {
        "win": "2.2081",
        "android": "2.2081"
    },

    "id": "neogd.hex-color-selector",
    "name": "Hex Color Selector",
    "version": "1.0.0",
    "developer": "Neo_",

    "description": "Customize your Geometry Dash icon colors using HEX colors, with optional dynamic rainbow colors.",

    "links": {
        "source": "https://github.com/NeoGd-Official/Hex-Color-Selector"
    },

    "settings": {
        "enabled": {
            "type": "bool",
            "name": "Enable Custom Colors",
            "default": true
        },

        "color1": {
            "type": "rgb",
            "name": "Color 1",
            "default": "#ffffff"
        },

        "color2": {
            "type": "rgb",
            "name": "Color 2",
            "default": "#ffffff"
        },

        "glow": {
            "type": "rgb",
            "name": "Glow",
            "default": "#ffffff"
        },

        "rainbow-color1": {
            "type": "bool",
            "name": "Rainbow Color 1",
            "default": false
        },

        "rainbow-color2": {
            "type": "bool",
            "name": "Rainbow Color 2",
            "default": false
        },

        "rainbow-glow": {
            "type": "bool",
            "name": "Rainbow Glow",
            "default": false
        },

        "rainbow-speed": {
            "type": "float",
            "name": "Rainbow Speed",
            "default": 1.0,
            "min": 0.1,
            "max": 5.0,
            "step": 0.1
        }
    }
}
