{
    "geode": "5.10.1",
    "gd": {
        "win": "2.2081",
        "android": "2.2081"
    },

    "id": "neogd.hex-color-selector",
    "name": "Hex Color Selector",
    "version": "1.0.0",
    "developer": "Neo_",

    "description": "Customize your Geometry Dash icon colors using HEX colors.",

    "links": {
        "source": "https://github.com/NeoGd-Official/Hex-Color-Selector",
        "community": "https://discord.gg/cEe88bSw3q"
    },

    "resources": {
        "sprites": [
            "resources/hex-button.png"
        ]
    },

    "settings": {
        "enabled": {
            "type": "bool",
            "name": "Enable Custom Colors",
            "default": true
        },

        "color1": {
            "type": "rgb",
            "name": "Color 1",
            "default": "#ffffff"
        },

        "color2": {
            "type": "rgb",
            "name": "Color 2",
            "default": "#ffffff"
        },

        "glow": {
            "type": "rgb",
            "name": "Glow",
            "default": "#ffffff"
        }
    }
